{
  "name": "starfleet",
  "version": "0.1.0",
  "description": "Board story-driven et orchestration des sessions d agents pour developpement assiste par IA",
  "type": "module",
  "private": true,
  "scripts": {
    "forge": "tsx backend/src/forge.ts",
    "hook:install": "tsx backend/src/installHook.ts",
    "dev:web": "vite",
    "build:back": "tsc -p tsconfig.json",
    "build:web": "vue-tsc -p tsconfig.web.json && vite build",
    "build": "npm run build:back && npm run build:web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^11.9.1",
    "hono": "^4.13.7",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^7.3.6",
    "vitest": "^3.0.8",
    "vue-tsc": "^3.3.11"
  }
}

{
  "name": "forge-ops",
  "version": "0.1.0",
  "description": "Board story-driven et orchestration des sessions d agents pour developpement assiste par IA",
  "type": "module",
  "private": true,
  "scripts": {
    "forge": "tsx backend/src/forge.ts",
    "hook:install": "tsx backend/src/installHook.ts",
    "demo": "tsx backend/src/demo.ts",
    "token:rotate": "tsx backend/src/rotateToken.ts",
    "seed:demo": "tsx backend/src/seedDemo.ts",
    "dev:web": "vite",
    "build:back": "tsc -p tsconfig.json",
    "build:web": "vue-tsc -p tsconfig.web.json && vite build",
    "build": "npm run build:back && npm run build:web",
    "lint": "eslint . --max-warnings=0 && node scripts/importDirection.js --check-baseline",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "gate:scripts": "tsx backend/src/checkScripts.ts",
    "gate:proof": "tsx backend/src/gateProof.ts",
    "arch:imports": "node scripts/importDirection.js",
    "arch:imports:baseline": "node scripts/importDirection.js --write-baseline",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:snapshot": "tsx backend/src/demoSnapshot.ts",
    "build:demo": "npm run demo:snapshot && VITE_FORGE_DEMO=true vite build --base=/forge-ops/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^11.9.1",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.7",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "11.4.10",
    "vue-router": "^5.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.1": true
  },
  "license": "AGPL-3.0-only",
  "author": "Gaetan Compigni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/forge-ops.git"
  }
}

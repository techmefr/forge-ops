  "build": {
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:8832",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Forge Ops", "width": 1400, "height": 900 }],
    "security": { "csp": null }

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "autostart:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "https://*:*" },
        { "url": "http://localhost" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://10.*.*.*" },
        { "url": "http://10.*.*.*:*" },
        { "url": "http://192.168.*.*" },
        { "url": "http://192.168.*.*:*" },
        { "url": "http://172.16.*.*" },
        { "url": "http://172.16.*.*:*" },
        { "url": "http://172.17.*.*" },
        { "url": "http://172.17.*.*:*" },
        { "url": "http://172.18.*.*" },
        { "url": "http://172.18.*.*:*" },
        { "url": "http://172.19.*.*" },
        { "url": "http://172.19.*.*:*" },
        { "url": "http://172.20.*.*" },
        { "url": "http://172.20.*.*:*" },
        { "url": "http://172.21.*.*" },
        { "url": "http://172.21.*.*:*" },
        { "url": "http://172.22.*.*" },
        { "url": "http://172.22.*.*:*" },
        { "url": "http://172.23.*.*" },
        { "url": "http://172.23.*.*:*" },
        { "url": "http://172.24.*.*" },
        { "url": "http://172.24.*.*:*" },
        { "url": "http://172.25.*.*" },
        { "url": "http://172.25.*.*:*" },
        { "url": "http://172.26.*.*" },
        { "url": "http://172.26.*.*:*" },
        { "url": "http://172.27.*.*" },
        { "url": "http://172.27.*.*:*" },
        { "url": "http://172.28.*.*" },
        { "url": "http://172.28.*.*:*" },
        { "url": "http://172.29.*.*" },
        { "url": "http://172.29.*.*:*" },
        { "url": "http://172.30.*.*" },
        { "url": "http://172.30.*.*:*" },
        { "url": "http://172.31.*.*" },
        { "url": "http://172.31.*.*:*" }
      ]
    }
  ]
}

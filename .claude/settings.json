{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/node_modules/.bin/tsx",
            "args": ["${CLAUDE_PROJECT_DIR}/src/technical/Guardrail/DenyHook.ts"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:8830/api/hooks",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
